<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Finance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15+ draws apps edge to edge by default; opt out so the page isn't under the status bar. Ignored on older versions. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:colorAccent">@color/tag</item>
    </style>
</resources>
